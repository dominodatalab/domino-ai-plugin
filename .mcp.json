{
  "mcpServers": {
    "domino_server": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/mcp-servers/domino_mcp_server",
        "domino_mcp_server.py"
      ],
      "env": {
        "DOMINO_PLUGIN_HOST": "${user_config.domino_host}",
        "DOMINO_PLUGIN_TOKEN": "${user_config.domino_token}"
      }
    },
    "domino_docs": {
      "type": "http",
      "url": "https://docs.domino.ai/mcp"
    }
  }
}
