# Environment variables server.js reads at start.
# In Domino, set them in the project's Settings > Environment variables (or as user variables);
# they are injected when the App starts. Never commit a .env file.
# For a local run only: copy to .env and start with `node --env-file=.env server.js`.

# Domino endpoint URL, copied from the endpoint's overview page in Domino (the deployment's external
# URL, https://<domino-domain>/models/<id>/latest/model). It comes from a person with access to that
# page: DOMINO_API_HOST does not route /models/.
MODEL_API_URL=

# Model Access Token created on that endpoint (Settings > Invocation > Add Model Access Token) or
# created and stored by the agent (domino-model-endpoints skill, "Access tokens").
# Synchronous endpoints use HTTP Basic auth with the token as username and password;
# asynchronous endpoints use "Authorization: Bearer". server.js handles the synchronous form.
# Never put this in a VITE_ variable: Vite compiles every VITE_* value into the browser bundle.
MODEL_API_TOKEN=

# Non-secret build-time values may use the VITE_ prefix and are read with import.meta.env.
# VITE_APP_TITLE=My Domino App
